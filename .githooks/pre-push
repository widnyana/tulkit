#!/usr/bin/env bash
# Pre-push gate via .pre-commit-config.yaml:
# gitleaks | bun audit | biome lint | next build. Aborts push on first failure.

set -euo pipefail

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "[pre-push] pre-commit not found; skipping. install: mise use -g pre-commit" >&2
  exit 0
fi

echo "[pre-push] running checks (secrets, vulns, lint, build)..."

if ! pre-commit run --hook-stage pre-push --all-files; then
  echo "[pre-push] checks failed; push blocked (bypass: git push --no-verify)." >&2
  exit 1
fi

echo "[pre-push] all checks passed."
